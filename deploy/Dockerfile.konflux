# Konflux prefetches npm and Go dependencies and injects their environment
# into RUN instructions. For local hermetic builds, use deploy/konflux/build-local.sh.
# Base images are digest-pinned and maintained by Renovate/MintMaker.
ARG NODE_IMAGE=registry.access.redhat.com/ubi9/nodejs-22:1-1790265744@sha256:510a73eeff392500e22eadf976686dbd16c27eaa1a8808f8f51b29fec950f68c
ARG GO_IMAGE=registry.access.redhat.com/ubi9/go-toolset:1.26@sha256:0a4666f7a4eb0644c97a73cba198eb268691b270d97831822689e7a2088f87be
ARG RUNTIME_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:1d7c5517a4a1a8e2688620b39ee980e82505ca1ab7ae5541b5463120ae9b3897

# --- Frontend build ---
FROM ${NODE_IMAGE} AS frontend

WORKDIR /opt/app-root/src
COPY --chown=1001:0 frontend/package.json frontend/package-lock.json ./
ENV CYPRESS_INSTALL_BINARY=0
RUN npm ci --offline --ignore-scripts --no-audit --no-fund

COPY --chown=1001:0 frontend/ ./
RUN npm run build -- --sourcemap false

# --- Backend build ---
FROM ${GO_IMAGE} AS backend

USER root
WORKDIR /opt/app-root/src
# Red Hat Go 1.26 activates strict checks through GOEXPERIMENT, not -tags.
ENV GOTOOLCHAIN=local \
    CGO_ENABLED=1 \
    GOEXPERIMENT=strictfipsruntime \
    GOFLAGS=-mod=readonly
COPY --chown=1001:0 backend/go.mod backend/go.sum ./
RUN go mod download

COPY --chown=1001:0 backend/ ./
RUN go build \
      -trimpath \
      -ldflags="-s -w" \
      -o /opt/app-root/src/openshell-dashboard \
      ./cmd/server

# --- Runtime ---
FROM ${RUNTIME_IMAGE}

ARG VERSION=0.0.0-semantically-released
LABEL com.redhat.component="odh-openshell-dashboard-container" \
      name="rhoai/odh-openshell-dashboard-rhel9" \
      version="${VERSION}" \
      description="Web admin UI and BFF for OpenShell sandboxed AI agent runtimes" \
      summary="odh-openshell-dashboard" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="8080:http" \
      io.k8s.display-name="odh-openshell-dashboard" \
      io.k8s.description="odh-openshell-dashboard" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

COPY --from=backend --chown=0:0 --chmod=0555 \
    /opt/app-root/src/openshell-dashboard \
    /usr/local/bin/openshell-dashboard
COPY --from=frontend --chown=0:0 --chmod=0555 \
    /opt/app-root/src/dist \
    /srv/static

ENV PORT=8080 \
    STATIC_DIR=/srv/static

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/openshell-dashboard"]
